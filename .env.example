DISCORD_TOKEN=your_discord_bot_token
MONGO_URI=your_mongodb_atlas_connection_string
CLIENT_ID=your_discord_application_client_id

# Development guild ID for instant command registration (required in non-production)
# DEV_GUILD_ID takes precedence. GUILD_ID is supported for backward compatibility.
DEV_GUILD_ID=your_test_discord_server_id
GUILD_ID=your_test_discord_server_id

MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
BOT_OWNER_ID=optional_owner_discord_user_id
TRUSTED_ADMIN_ROLE_IDS=optional_role_id,optional_second_role_id
DASHBOARD_URL=
ENABLE_API=false
API_PORT=3000
API_RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW=1 minute
DASHBOARD_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:3000
SESSION_SECRET=replace_with_at_least_32_random_characters
DISCORD_CLIENT_SECRET=your_discord_application_client_secret
NODE_ENV=development

# Enables the local World Tree YouTube extractor. Leave false to retain the
# upstream discord-player-youtubei path during the staged rollout.
USE_LOCAL_YOUTUBE_EXTRACTOR=false

# Spotify (optional - improves Spotify search accuracy)
DP_SPOTIFY_CLIENT_ID=your_spotify_client_id
DP_SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
