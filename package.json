{
  "name": "world-tree",
  "version": "0.6.1",
  "description": "World Tree Discord utility and moderation bot.",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "register:commands": "node scripts/registerCommands.js",
    "test": "node --test",
    "migrate": "node scripts/migrate.js",
    "format": "prettier --write \"src/**/*.{js,json,md}\" \"test/**/*.{js,json,md}\" \"scripts/**/*.{js,json,md}\" \"*.js\" \"*.json\" \"*.md\"",
    "format:check": "prettier --check \"src/**/*.{js,json,md}\" \"test/**/*.{js,json,md}\" \"scripts/**/*.{js,json,md}\" \"*.js\" \"*.json\" \"*.md\"",
    "lint": "eslint \"src/**/*.js\" \"test/**/*.js\" \"scripts/**/*.js\" \"*.js\"",
    "lint:fix": "eslint \"src/**/*.js\" \"test/**/*.js\" \"scripts/**/*.js\" \"*.js\" --fix",
    "ops:deploy": "bash ops/deploy.sh",
    "ops:update": "bash ops/update.sh",
    "ops:start": "bash ops/start.sh",
    "ops:stop": "bash ops/stop.sh",
    "ops:restart": "bash ops/restart.sh",
    "ops:switch": "bash ops/switch.sh",
    "ops:health": "bash ops/health.sh",
    "ops:status": "bash ops/status.sh",
    "ops:info": "bash ops/info.sh",
    "ops:logs": "bash ops/logs.sh",
    "ops:verify": "bash ops/verify.sh",
    "ops:doctor": "bash ops/doctor.sh",
    "ops:backup": "bash ops/backup.sh",
    "ops:restore": "bash ops/restore.sh",
    "ops:rollback": "bash ops/rollback.sh"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "discord",
    "bot",
    "moderation",
    "utility",
    "fastify",
    "mongodb",
    "oauth2",
    "music"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@discord-player/extractor": "^7.2.0",
    "@discordjs/voice": "^0.19.2",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^11.0.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^6.0.0",
    "discord-player": "^7.2.0",
    "discord-player-youtubei": "^3.0.0-beta.4",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^6.1.0",
    "ffmpeg-static": "^5.3.0",
    "mongoose": "^9.6.2",
    "ms": "^2.1.3",
    "pino": "^10.3.1",
    "tweetnacl": "^1.0.3",
    "youtube-dl-exec": "^3.1.9",
    "youtubei.js": "17.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.4"
  }
}
